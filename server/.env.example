# Supabase runtime URL, used by Prisma's pg driver adapter. Use the direct URL
# for an IPv6-capable Docker/VM host, or the Supavisor session pooler on IPv4.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# Supabase direct URL, used by Prisma migrations and Studio.
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

PORT=3000
NODE_ENV=development


JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=1d